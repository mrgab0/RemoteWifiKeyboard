<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060E20"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Top Daemon & Port Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/badge_pill_live"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="#00FF88"
                    android:layout_marginRight="6dp" />

                <TextView
                    android:id="@+id/tvDaemonHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAEMON: ACTIVO (v2.4)"
                    android:textColor="#00FF88"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPortBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PORT: 8080"
                android:textColor="#00F0FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/badge_pill_status"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <!-- Brand Icon & Titles -->
        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_remote_keyboard_pro"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remote WiFi Keyboard"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escribe desde tu PC a tu Android en tiempo real"
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:layout_marginTop="2dp" />

        <!-- Card 1: Server URL Card -->
        <LinearLayout
            android:id="@+id/cardServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_cyber_dark"
            android:padding="16dp"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/tvServerCardSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Abre esta dirección en tu PC / Navegador:"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/tvUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="http://192.168.1.105:8080"
                android:textColor="#00F0FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginTop="6dp"
                android:layout_gravity="center_horizontal"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/btnCopyUrl"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="📋 COPIAR DIRECCIÓN URL"
                android:textColor="#060E20"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="@drawable/btn_action_cyber"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Card 2: IME Keyboard Setup -->
        <LinearLayout
            android:id="@+id/cardIme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_cyber_dark"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvImeCardHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⌨️ TECLADO DEL SISTEMA"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvImePillBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IME Service"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:background="@drawable/badge_pill_status"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvImeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Estado: 🟡 Esperando verificación..."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnEnableIme"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="1. Habilitar Teclado en Ajustes"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#162444"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnSelectIme"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="2. Seleccionar como Teclado Activo"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#162444"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnAccessibility"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="3. Habilitar Recientes / Atrás (Accesibilidad Opcional)"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:backgroundTint="#0C1527"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Card 3: Theme Selector (Cyber-Dark, AMOLED Battery Saver, Light) -->
        <LinearLayout
            android:id="@+id/cardTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_cyber_dark"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvThemeCardHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎨 TEMAS VISUALES DE LA APP"
                    android:textColor="#00F0FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvThemeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CYBER-DARK"
                    android:textColor="#00F0FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/badge_pill_status"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 1. Cyber Dark -->
                <LinearLayout
                    android:id="@+id/themeDarkBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/btn_theme_selected"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌌"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvLabelDark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dark"
                        android:textColor="#00F0FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- 2. AMOLED Dark Battery Saver -->
                <LinearLayout
                    android:id="@+id/themeAmoledBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/btn_theme_unselected"
                    android:padding="10dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvLabelAmoled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AMOLED"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- 3. Light Theme -->
                <LinearLayout
                    android:id="@+id/themeLightBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/btn_theme_unselected"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☀️"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvLabelLight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Light"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Card 4: Telemetry & Haptic Settings -->
        <LinearLayout
            android:id="@+id/cardTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_cyber_dark"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTelemetryHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📊 TELEMETRÍA Y DIAGNÓSTICO"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPingBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ &lt;3ms"
                    android:textColor="#34D399"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/badge_pill_status"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWsClients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Conexión PC: ⚪ Esperando conexión desde navegador/app..."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Servidor: 🟢 Activo (NanoHTTPD + WebSocket)"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvKeystrokes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Pulsaciones Recibidas: 0 teclas"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <!-- Switch Vibración Háptica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvVibSwitchLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📳 Vibración Háptica"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <Switch
                    android:id="@+id/switchVibration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Intensity Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvVibIntensity"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:text="Intensidad: 100%"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seekBarVibration"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="100" />
            </LinearLayout>

            <!-- Duration Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvVibDuration"
                    android:layout_width="85dp"
                    android:layout_height="wrap_content"
                    android:text="Duración: 50%"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seekBarVibrationDuration"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 5: Live Testing Area -->
        <LinearLayout
            android:id="@+id/cardTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_cyber_dark"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvTestAreaHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 ÁREA DE PRUEBA EN VIVO"
                android:textColor="#818CF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTestAreaHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toca el cuadro para abrir el teclado y escribe desde tu PC:"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <EditText
                android:id="@+id/etTestInput"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:hint="Haz clic aquí y escribe desde la PC..."
                android:textColorHint="#475569"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:gravity="top|start"
                android:background="#0A1224"
                android:padding="12dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Card 6: PRO Upgrade Card -->
        <LinearLayout
            android:id="@+id/layoutProUpgrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_cyber_dark"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👑 Licencia PRO de por Vida"
                    android:textColor="#FFD700"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50% OFF"
                    android:textColor="#000000"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="#FFD700"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cero anuncios, latencia ultra-baja y temas exclusivos."
                android:textColor="#B0BEC5"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnBuyPro"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="Desbloquear PRO por $7.99 USD 🚀"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#FFD700"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Dynamic AdMob Container -->
        <LinearLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="14dp" />

    </LinearLayout>
</ScrollView>
