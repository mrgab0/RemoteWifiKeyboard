<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1015"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Logo / Icon -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_keyboard" />

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remote WiFi Keyboard"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escribe desde tu PC a tu Android en tiempo real"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:layout_marginTop="2dp"
            android:gravity="center" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1C23"
            android:padding="18dp"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Servidor Activo en este Teléfono"
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Abre esta dirección en el navegador o app de tu PC:"
                android:textColor="#B0BEC5"
                android:textSize="11sp"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="http://192.168.1.105:8080"
                android:textColor="#818CF8"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/btnCopyUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Copiar Dirección URL"
                android:textColor="#000000"
                android:backgroundTint="#818CF8"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- Setup Step 1 -->
        <Button
            android:id="@+id/btnEnableIme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Habilitar Teclado en Ajustes"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2D323F"
            android:layout_marginTop="14dp" />

        <!-- Setup Step 2 -->
        <Button
            android:id="@+id/btnSelectIme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Seleccionar como Teclado Activo"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2D323F"
            android:layout_marginTop="8dp" />

        <!-- Test Input Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141724"
            android:padding="16dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 Área de Prueba en Vivo:"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTestInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Toca aquí para probar escribir desde tu PC..."
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:background="#0B0D14"
                android:padding="12dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- High-Converting PRO Upgrade Card -->
        <LinearLayout
            android:id="@+id/layoutProUpgrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1F1E2E"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="👑 Licencia PRO de por Vida"
                    android:textColor="#FFD700"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50% OFF"
                    android:textColor="#000000"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="#FFD700"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cero anuncios, Clipboard Sync automático y máxima velocidad."
                android:textColor="#B0BEC5"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnBuyPro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Desbloquear PRO por $7.99 USD 🚀"
                android:textColor="#000000"
                android:backgroundTint="#FFD700"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Dynamic AdMob Container -->
        <LinearLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
