<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Package Visibility para Lanzador Remoto de Aplicaciones en Android 11+ (API 30+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.termux" />
        <package android:name="com.whatsapp" />
        <package android:name="com.foxdebug.acode" />
        <package android:name="com.spdk.editor" />
        <package android:name="com.vscode.mobile" />
        <package android:name="org.telegram.messenger" />
        <package android:name="md.obsidian" />
        <package android:name="com.android.settings" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.android.chrome" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_remote_keyboard_pro"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_remote_keyboard_pro"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.RemoteKeyboard">

        <!-- Google AdMob App ID (Test ID para desarrollo y revisión de tienda) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>

        <!-- Pantalla Principal de Configuración y Prueba -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RemoteKeyboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Selector Rápido de Temas Base16 -->
        <activity
            android:name=".theme.ThemePickerActivity"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar"
            android:excludeFromRecents="true"
            android:exported="false" />


        <!-- Servicio de Teclado del Sistema (Input Method Service) -->
        <service
            android:name=".RemoteInputMethodService"
            android:label="@string/keyboard_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Servicio de Accesibilidad para Simular Toques de Ratón y Gestos -->
        <service
            android:name=".accessibility.RemoteAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/accessibility_service_desc"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Provider para compartir imágenes del portapapeles a otras apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

    </application>

</manifest>
