{
  "name": "remote-wifi-keyboard",
  "version": "2.0.0",
  "description": "Remote WiFi Keyboard Windows Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win portable"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-winstaller": "^5.4.4"
  },
  "build": {
    "appId": "com.mrgab0.remotewifikeyboard",
    "productName": "Remote WiFi Keyboard",
    "files": [
      "main.js",
      "index.html",
      "widget.html",
      "synergy-capture.html",
      "shortcuts.js",
      "icon.png",
      "icon.ico",
      "package.json"
    ],
    "compression": "normal",
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    }
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
